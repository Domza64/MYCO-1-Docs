---
import Button from "./Button.astro";
---

<section class="flex flex-col items-center text-center">
  <h1 class="w-full flex justify-center pb-3">
    <img src="/MYC0-1.svg" alt="MYC0-1 Music Player" class="w-full max-w-100" />
  </h1>

  <p class="md:text-lg text-rose-400 font-semibold pb-10">
    A simple self-hosted music streaming app.
  </p>

  <div class="flex gap-4 justify-center mb-4">
    <Button href="/getting-started/installation" variant="primary">
      Download
    </Button>
    <Button variant="disabled">Demo (soon)</Button>
  </div>
  <Button
    href="https://github.com/Domza64/MYC0-1"
    variant="ghost"
    icon="lucide:github"
  >
    View on GitHub
  </Button>
</section>
