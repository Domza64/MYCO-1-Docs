---
const roadmap = [
  {
    phase: "Alpha",
    title: "Early development",
    description: "Unreleased app with lots of breaking changes",
    status: "In Progress...",
    statusClass: "",
    items: [
      "A functional music player",
      "Playlist management",
      "Play history",
      "Multi user support",
    ],
  },
  {
    phase: "Version 1",
    title: "First release",
    items: ['Just a stable "production" ready build'],
  },
  {
    phase: "Version 2",
    title: "It's getting serious",
    items: [
      "Bunch of random quality of life improvements",
      "Some kind of smart autogenerated playlists",
      "Similar song recommendations",
      "UI polish & animations",
      "Cross-device playback sync and WebSocket-based remote control",
    ],
  },
  {
    phase: "Version 3",
    title: "Probably a while till we get here...",
    items: [
      "Native mobile app, Tauri?",
      "Song Metadata editing",
      "Metadata auto discovery?",
    ],
  },
];
---

<section class="mx-auto" id="roadmap">
  <div class="text-center mb-6">
    <h2>The Journey Ahead</h2>
    <p class="text-stone-400 sm:text-[17px] text-sm">
      Some of the plans for the future!
    </p>
  </div>

  <div class="space-y-6">
    {roadmap.map((step) => (
      <div
        class={`bg-stone-900 rounded sm:p-6 p-4 ${step.status ? "pt-0!" : ""}`}
      >
        <div class="w-full flex justify-center mb-1">
          {step.status && (
            <span
              class={`px-4 py-1.5 rounded-b-lg text-xs font-semibold bg-stone-800 text-stone-400 ${step.statusClass}`}
            >
              {step.status}
            </span>
          )}
        </div>
        <div class="flex items-start justify-between mb-6">
          <div>
            <span class="text-stone-500 font-semibold">{step.phase}</span>
            <h3 class="text-xl font-bold">{step.title}</h3>
            {step.description && (
              <p class="text-stone-200 text-sm">{step.description}</p>
            )}
          </div>
        </div>

        <div class="grid md:grid-cols-2 gap-3 md:[&>*:last-child:nth-child(odd)]:col-span-2">
          {step.items.map((item) => (
            <div class="relative rounded overflow-hidden pl-4 py-2 bg-stone-800 text-stone-400 text-sm">
              <span class="absolute left-0 top-0 bottom-0 w-0.5 bg-stone-500/80"></span>
              {item}
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
