---
import { Icon } from "astro-icon/components";

const features = [
  {
    title: "Self-Hosted",
    description:
      "Your server, your music, your rules. No ads, no tracking, none of that s**t.",
    icon: "lucide:server",
  },
  {
    title: "Enjoy Your Music",
    description:
      "Just point MYC0-1 at your libray and let it do its thing. Sit back and enjoy the music.",
    icon: "lucide:disc-3",
  },
  {
    title: "Playlists",
    description: "Um, You can create playlists! Wow!",
    icon: "lucide:list-music",
  },
  {
    title: "Search",
    description:
      "Search your library by authors, albums, titles... It's just a search function.",
    icon: "lucide:search",
  },
  {
    title: "Multi User",
    description:
      "Create an accounts for a few friends you might have. Make everyone listen to the best stuff.",
    icon: "lucide:users",
  },
  {
    title: "huh?",
    description:
      "Where's the 6th option? There's much more stuff comming... one undefined day!",
    icon: "lucide:package-question-mark",
  },
];
---

<section class="mx-auto">
  <div class="text-center mb-6">
    <h2>What's this?</h2>
    <p class="text-stone-400 sm:text-[17px] text-sm">
      Just a simple music streaming app with all the basic features that you
      might expect.
    </p>
  </div>

  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
    {features.map((feature) => (
      <div class="bg-stone-900 rounded sm:p-6 p-4 border-stone-800">
        <div class="w-12 h-12 bg-stone-700/50 rounded flex items-center justify-center mb-4">
          <Icon name={feature.icon} size={24} class="text-stone-400" />
        </div>

        <h3 class="text-lg font-semibold mb-2">{feature.title}</h3>
        <p class="text-stone-400 text-sm leading-relaxed">
          {feature.description}
        </p>
      </div>
    ))}
  </div>
</section>
