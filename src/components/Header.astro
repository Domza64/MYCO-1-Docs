---
import Button from "./Button.astro";
---

<header class="mx-auto sm:pt-4 pt-3 max-w-5xl">
  <nav class="flex justify-between items-center">
    <a href="/">
      <img src="/MYC0-1.svg" alt="MYC0-1 Logo" class="md:w-32 w-24" />
    </a>

    <div class="flex gap-2">
      <Button
        href="/getting-started/installation"
        variant="primary"
        size="sm"
        class="hidden md:flex"
      >
        Download
      </Button>
      <Button
        href="https://github.com/Domza64/MYC0-1"
        variant="ghost"
        icon="lucide:github"
        size="sm"
      >
        View on GitHub
      </Button>
    </div>
  </nav>
</header>
